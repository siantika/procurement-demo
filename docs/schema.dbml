  actual_margin_percent decimal(7, 4)
  max_margin_percent decimal(7, 4)
  is_hps_feasible boolean
  currency varchar(3) [not null, note: 'Django default: \'IDR\'']
  calculation_version varchar(32) [not null]
  snapshot_schema_version integer [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada']
  selected_result_snapshot jsonb [not null]
  submission_snapshot jsonb
  submission_hash varchar(64)
  submitted_by_id uuid [ref: > accounts_user.id, note: 'FK accounts_user.id; PROTECT']
  submitted_at timestamptz
  created_by_id uuid [not null, ref: > accounts_user.id, note: 'FK accounts_user.id; PROTECT']
  version integer [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada; Django default: 1']
  created_at timestamptz [not null, note: 'Django auto_now_add']
  updated_at timestamptz [not null, note: 'Django auto_now']

  indexes {
    (bid_proposal_id, revision_number) [unique, name: 'bid_revision_number_unique']
    (status, updated_at) [name: 'bid_revision_status_idx']
  }

  Note: 'bid_revision_number_positive: CONSTRAINT "bid_revision_number_positive" CHECK ("revision_number" > 0) | bid_revision_version_positive: CONSTRAINT "bid_revision_version_positive" CHECK ("version" > 0) | bid_revision_schema_positive: CONSTRAINT "bid_revision_schema_positive" CHECK ("snapshot_schema_version" > 0) | bid_revision_currency_idr: CONSTRAINT "bid_revision_currency_idr" CHECK ("currency" = \'IDR\') | bid_revision_margin_bounded: CONSTRAINT "bid_revision_margin_bounded" CHECK (("target_margin_percent" IS NULL OR ("target_margin_percent" >= 0 AND "target_margin_percent" < 100))) | bid_revision_purchase_positive: CONSTRAINT "bid_revision_purchase_positive" CHECK (("total_purchase" IS NULL OR "total_purchase" > 0)) | bid_revision_value_positive: CONSTRAINT "bid_revision_value_positive" CHECK (("total_bid_value" IS NULL OR "total_bid_value" > 0)) | bid_revision_profit_nonnegative: CONSTRAINT "bid_revision_profit_nonnegative" CHECK (("gross_profit" IS NULL OR "gross_profit" >= 0)) | bid_revision_pricing_payload_valid: CONSTRAINT "bid_revision_pricing_payload_valid" CHECK ((("actual_margin_percent" IS NULL AND "gross_profit" IS NULL AND "is_hps_feasible" IS NULL AND "max_margin_percent" IS NULL AND "target_margin_percent" IS NULL AND "total_bid_value" IS NULL) OR ("actual_margin_percent" IS NOT NULL AND "gross_profit" IS NOT NULL AND "target_margin_percent" IS NOT NULL AND "total_bid_value" IS NOT NULL AND "total_purchase" IS NOT NULL))) | bid_revision_submission_payload_valid: CONSTRAINT "bid_revision_submission_payload_valid" CHECK ((("status" = \'DRAFT\' AND "submission_hash" IS NULL AND "submission_snapshot" IS NULL AND "submitted_at" IS NULL AND "submitted_by_id" IS NULL) OR ("actual_margin_percent" IS NOT NULL AND "gross_profit" IS NOT NULL AND "status" IN (\'WAITING_APPROVAL\', \'APPROVED\', \'REJECTED\', \'SIGNED\', \'FINALIZED\') AND "submission_hash" IS NOT NULL AND "submission_snapshot" IS NOT NULL AND "submitted_at" IS NOT NULL AND "submitted_by_id" IS NOT NULL AND "target_margin_percent" IS NOT NULL AND "total_bid_value" IS NOT NULL AND "total_purchase" IS NOT NULL))) | bid_revision_status_idx: Django ordering status, -updated_at'
}

Table bids_bid_proposal_item {
  id uuid [pk, not null, note: 'Django default: uuid.uuid4']
  bid_revision_id uuid [not null, ref: > bids_bid_proposal_revision.id, note: 'FK bids_bid_proposal_revision.id; CASCADE']
  tender_request_item_id uuid [not null, ref: > tender_tender_request_item.id, note: 'FK tender_tender_request_item.id; PROTECT']
  line_number integer [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada']
  product_snapshot jsonb [not null]
  requested_quantity decimal(18, 3) [not null]
  unit varchar(32) [not null]
  item_purchase_total decimal(20, 2) [not null]
  unit_purchase_cost decimal(20, 4) [not null]
  bid_unit_price decimal(20, 4) [not null]
  item_bid_total decimal(20, 2) [not null]
  currency varchar(3) [not null, note: 'Django default: \'IDR\'']
  created_at timestamptz [not null, note: 'Django auto_now_add']

  indexes {
    (bid_revision_id, tender_request_item_id) [unique, name: 'bid_item_tender_unique']
    (bid_revision_id, line_number) [unique, name: 'bid_item_line_unique']
  }

  Note: 'bid_item_line_positive: CONSTRAINT "bid_item_line_positive" CHECK ("line_number" > 0) | bid_item_quantity_positive: CONSTRAINT "bid_item_quantity_positive" CHECK ("requested_quantity" > 0) | bid_item_purchase_positive: CONSTRAINT "bid_item_purchase_positive" CHECK ("item_purchase_total" > 0) | bid_item_unit_purchase_positive: CONSTRAINT "bid_item_unit_purchase_positive" CHECK ("unit_purchase_cost" > 0) | bid_item_unit_price_positive: CONSTRAINT "bid_item_unit_price_positive" CHECK ("bid_unit_price" > 0) | bid_item_total_positive: CONSTRAINT "bid_item_total_positive" CHECK ("item_bid_total" > 0) | bid_item_currency_idr: CONSTRAINT "bid_item_currency_idr" CHECK ("currency" = \'IDR\')'
}

Table approval_approval_decision {
  id uuid [pk, not null, note: 'Django default: uuid.uuid4']
  bid_revision_id uuid [not null, unique, ref: - bids_bid_proposal_revision.id, note: 'FK bids_bid_proposal_revision.id; PROTECT']
  decision varchar(16) [not null, note: 'choices: APPROVED, REJECTED']
  reason text
  submission_hash varchar(64) [not null]
  decided_by_id uuid [not null, ref: > accounts_user.id, note: 'FK accounts_user.id; PROTECT']
  decided_at timestamptz [not null, note: 'Django default: django.utils.timezone.now']
  created_at timestamptz [not null, note: 'Django auto_now_add']

  indexes {
    (decided_by_id, decided_at) [name: 'approval_manager_decided_idx']
  }

  Note: 'approval_decision_reason_valid: CONSTRAINT "approval_decision_reason_valid" CHECK ((("decision" = \'APPROVED\' AND "reason" IS NULL) OR ("decision" = \'REJECTED\' AND "reason" IS NOT NULL AND NOT ("reason" = \'\' AND "reason" IS NOT NULL)))) | approval_manager_decided_idx: Django ordering decided_by, -decided_at'
}

Table signatures_signature {
  id uuid [pk, not null, note: 'Django default: uuid.uuid4']
  bid_revision_id uuid [not null, unique, ref: - bids_bid_proposal_revision.id, note: 'FK bids_bid_proposal_revision.id; PROTECT']
  approval_decision_id uuid [not null, unique, ref: - approval_approval_decision.id, note: 'FK approval_approval_decision.id; PROTECT']
  signed_by_id uuid [not null, ref: > accounts_user.id, note: 'FK accounts_user.id; PROTECT']
  signer_name varchar(255) [not null]
  signed_snapshot_hash varchar(64) [not null]
  image_object_key varchar(512) [unique]
  image_version_id varchar(255)
  image_mime_type varchar(100)
  image_size_bytes bigint [note: 'nonnegative integer (field type); positive checks terpisah jika ada']
  image_sha256 varchar(64)
  signed_at timestamptz [not null, note: 'Django default: django.utils.timezone.now']
  created_at timestamptz [not null, note: 'Django auto_now_add']

  Note: 'signature_image_metadata_valid: CONSTRAINT "signature_image_metadata_valid" CHECK ((("image_mime_type" IS NULL AND "image_object_key" IS NULL AND "image_sha256" IS NULL AND "image_size_bytes" IS NULL AND "image_version_id" IS NULL) OR ("image_mime_type" IN (\'image/png\', \'image/jpeg\') AND "image_object_key" IS NOT NULL AND "image_sha256" IS NOT NULL AND "image_size_bytes" > 0 AND "image_size_bytes" <= 1048576)))'
}

Table documents_number_sequence {
  year integer [pk, not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada']
  next_number integer [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada; Django default: 1']
}

Table documents_generation_job {
  id uuid [pk, not null, note: 'Django default: uuid.uuid4']
  bid_revision_id uuid [not null, ref: > bids_bid_proposal_revision.id, note: 'FK bids_bid_proposal_revision.id; PROTECT']
  status varchar(20) [not null, note: 'choices: PENDING, RUNNING, COMPLETED, FAILED; Django default: GenerationJobStatus.PENDING']
  document_version integer [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada']
  template_version varchar(32) [not null, note: 'Django default: \'1\'']
  snapshot_schema_version integer [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada']
  input_snapshot jsonb [not null]
  input_hash varchar(64) [not null]
  attempt_count integer [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada; Django default: 0']
  safe_error_code varchar(64)
  safe_error_message text
  diagnostic_reference varchar(100)
  requested_by_id uuid [not null, ref: > accounts_user.id, note: 'FK accounts_user.id; PROTECT']
  started_at timestamptz
  completed_at timestamptz
  version integer [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada; Django default: 1']
  created_at timestamptz [not null, note: 'Django auto_now_add']

  indexes {
    (bid_revision_id, document_version) [unique, name: 'document_job_version_unique']
    (status, created_at) [name: 'document_job_status_idx']
    (bid_revision_id, document_version) [name: 'document_job_revision_idx']
  }

  Note: 'document_job_version_positive: CONSTRAINT "document_job_version_positive" CHECK ("document_version" > 0) | document_job_schema_positive: CONSTRAINT "document_job_schema_positive" CHECK ("snapshot_schema_version" > 0) | document_job_row_version_positive: CONSTRAINT "document_job_row_version_positive" CHECK ("version" > 0) | document_job_terminal_payload_valid: CONSTRAINT "document_job_terminal_payload_valid" CHECK ((("completed_at" IS NULL AND "status" IN (\'PENDING\', \'RUNNING\')) OR ("completed_at" IS NOT NULL AND "safe_error_code" IS NULL AND "status" = \'COMPLETED\') OR ("completed_at" IS NOT NULL AND "safe_error_code" IS NOT NULL AND "status" = \'FAILED\'))) | document_job_revision_idx: Django ordering bid_revision, -document_version'
}

Table documents_final_document {
  id uuid [pk, not null, note: 'Django default: uuid.uuid4']
  generation_job_id uuid [not null, unique, ref: - documents_generation_job.id, note: 'FK documents_generation_job.id; PROTECT']
  bid_revision_id uuid [not null, ref: > bids_bid_proposal_revision.id, note: 'FK bids_bid_proposal_revision.id; PROTECT']
  document_version integer [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada']
  document_number varchar(100) [not null]
  template_version varchar(32) [not null]
  object_key varchar(512) [not null, unique]
  object_version_id varchar(255)
  mime_type varchar(100) [not null, note: 'Django default: \'application/pdf\'']
  size_bytes bigint [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada']
  sha256 varchar(64) [not null]
  snapshot_schema_version integer [not null, note: 'nonnegative integer (field type); positive checks terpisah jika ada']
  content_snapshot jsonb [not null]
  finalized_by_id uuid [not null, ref: > accounts_user.id, note: 'FK accounts_user.id; PROTECT']
  created_at timestamptz [not null, note: 'Django auto_now_add']

  indexes {
    (bid_revision_id, document_version) [unique, name: 'final_document_version_unique']
    (bid_revision_id, document_version) [name: 'final_document_revision_idx']
  }

  Note: 'final_document_version_positive: CONSTRAINT "final_document_version_positive" CHECK ("document_version" > 0) | final_document_size_positive: CONSTRAINT "final_document_size_positive" CHECK ("size_bytes" > 0) | final_document_schema_positive: CONSTRAINT "final_document_schema_positive" CHECK ("snapshot_schema_version" > 0) | final_document_pdf_mime: CONSTRAINT "final_document_pdf_mime" CHECK ("mime_type" = \'application/pdf\') | final_document_revision_idx: Django ordering bid_revision, -document_version'
}

Table notifications_notification {
  id uuid [pk, not null, note: 'Django default: uuid.uuid4']
  recipient_id uuid [not null, ref: > accounts_user.id, note: 'FK accounts_user.id; PROTECT']
  type varchar(40) [not null, note: 'choices: BID_WAITING_APPROVAL, OPTIMIZATION_COMPLETED, OPTIMIZATION_FAILED, BID_APPROVED, BID_REJECTED, BID_SIGNED, DOCUMENT_COMPLETED, DOCUMENT_FAILED']
  source_event_id uuid [not null]
  source_entity_type varchar(64) [not null]
  source_entity_id uuid [not null]
  title varchar(255) [not null]
  message text [not null]
  read_at timestamptz
  created_at timestamptz [not null, note: 'Django auto_now_add']

  indexes {
    (recipient_id, source_event_id, type) [unique, name: 'notification_event_recipient_unique']
    (recipient_id, read_at, created_at) [name: 'notif_recipient_read_idx']
  }

  Note: 'notif_recipient_read_idx: Django ordering recipient, read_at, -created_at'
}

Table audit_audit_event {
  id uuid [pk, not null, note: 'Django default: uuid.uuid4']
  actor_id uuid [ref: > accounts_user.id, note: 'FK accounts_user.id; PROTECT']
  actor_name varchar(255) [not null]
  entity_type varchar(64) [not null]
  entity_id uuid [not null]
  entity_revision integer [note: 'nonnegative integer (field type); positive checks terpisah jika ada']
  action varchar(64) [not null]
  from_status varchar(32)
  to_status varchar(32)
  reason text
  metadata jsonb [not null, note: 'Django default: builtins.dict']
  correlation_id varchar(100) [not null]
  occurred_at timestamptz [not null, note: 'Django auto_now_add']

  indexes {
    (entity_type, entity_id, occurred_at) [name: 'audit_entity_timeline_idx']
    (actor_id, occurred_at) [name: 'audit_actor_timeline_idx']
  }

  Note: 'audit_event_revision_positive: CONSTRAINT "audit_event_revision_positive" CHECK (("entity_revision" IS NULL OR "entity_revision" > 0)) | audit_entity_timeline_idx: Django ordering entity_type, entity_id, -occurred_at | audit_actor_timeline_idx: Django ordering actor, -occurred_at'
}
