  is_superuser boolean [not null, note: 'Django default: False']
  username varchar(150) [not null, unique]
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  is_staff boolean [not null, note: 'Django default: False']
  is_active boolean [not null, note: 'Django default: True']
  date_joined timestamptz [not null, note: 'Django default: django.utils.timezone.now']
  id uuid [pk, not null, note: 'Django default: uuid.uuid4']
  email varchar(254) [not null, unique]
  full_name varchar(255) [not null]
  role varchar(32) [not null, note: 'choices: ADMIN, PROCUREMENT_STAFF, MANAGER']
  created_at timestamptz [not null, note: 'Django auto_now_add']
  updated_at timestamptz [not null, note: 'Django auto_now']

  Note: 'accounts_user_role_valid: CONSTRAINT "accounts_user_role_valid" CHECK ("role" IN (\'ADMIN\', \'PROCUREMENT_STAFF\', \'MANAGER\')) | accounts_user_staff_requires_admin_role: CONSTRAINT "accounts_user_staff_requires_admin_role" CHECK ((NOT "is_staff" OR "role" = \'ADMIN\')) | accounts_user_username_ci_unique: CREATE UNIQUE INDEX "accounts_user_username_ci_unique" ON "accounts_user" ((LOWER("username"))) | accounts_user_email_ci_unique: CREATE UNIQUE INDEX "accounts_user_email_ci_unique" ON "accounts_user" ((LOWER("email")))'
}

