Project medical_procurement_bid_optimizer {
  database_type: 'PostgreSQL'
  Note: '''
    Demo MVP schema baseline derived from docs/06-data-model.md.
    Django migrations are the executable schema source after implementation starts.
    Cross-row and workflow invariants are enforced by application services in transactions.
    Django migrations add CheckConstraint and functional/partial unique indexes described in the data-model document.
  '''
}

Table accounts_user {
  id uuid [pk]
  username varchar(150) [not null, unique, note: 'Django migration also enforces case-insensitive uniqueness']
  email varchar(254) [not null, unique, note: 'Django migration also enforces case-insensitive uniqueness']
  password varchar(128) [not null, note: 'Django password hash; never plaintext']
  full_name varchar(255) [not null]
  role varchar(32) [not null, note: 'ADMIN | PROCUREMENT_STAFF | MANAGER']
  is_active boolean [not null, default: true]
  is_staff boolean [not null, default: false]
  is_superuser boolean [not null, default: false]
  last_login timestamptz
  date_joined timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Custom Django user model with UUID primary key.'
}

Table catalog_product {
  id uuid [pk]
  code varchar(50) [not null, unique, note: 'Django migration also enforces case-insensitive uniqueness']
  name varchar(255) [not null]
  description text
  default_unit varchar(32) [not null]
  is_active boolean [not null, default: true]
  version integer [not null, default: 1]
  created_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active, name)
  }
}

Table catalog_supplier {
  id uuid [pk]
  code varchar(50) [not null, unique, note: 'Django migration also enforces case-insensitive uniqueness']
  name varchar(255) [not null]
  contact_name varchar(255)
  email varchar(254)
  phone varchar(50)
  address text
  is_active boolean [not null, default: true]
  version integer [not null, default: 1]
  created_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active, name)
  }
}

Table sourcing_supplier_offer {
  id uuid [pk]
  supplier_id uuid [not null, ref: > catalog_supplier.id, note: 'PROTECT']
  product_id uuid [not null, ref: > catalog_product.id, note: 'PROTECT']
  supersedes_offer_id uuid [ref: > sourcing_supplier_offer.id, unique, note: 'PROTECT; nullable']
  supplier_reference varchar(100)
  base_unit_price numeric(20,4) [not null]
  discount_percent numeric(7,4) [not null, default: 0]
  net_purchase_price numeric(20,4) [not null, note: 'May be zero for recorded 100% discount; eligibility requires > 0']
  currency char(3) [not null, default: 'IDR']
  available_quantity numeric(18,3) [note: 'Nullable; reusable per Bid, not global stock']
  valid_from date
  valid_until date
  is_active boolean [not null, default: true]
  calculation_version varchar(32) [not null]
  version integer [not null, default: 1]
  created_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (product_id, is_active, valid_until)
    (supplier_id, product_id, created_at)
  }
}

Table tender_tender_request {
  id uuid [pk]
  internal_code varchar(50) [not null, unique]
  current_revision_number integer [not null, default: 1]
  version integer [not null, default: 1]
  created_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    created_at
  }
}

Table tender_tender_request_revision {
  id uuid [pk]
  tender_request_id uuid [not null, ref: > tender_tender_request.id, note: 'CASCADE inside aggregate']
  revision_number integer [not null]
  tender_reference_number varchar(100)
  institution_name varchar(255) [not null]
  institution_address text
  title varchar(255) [not null]
  description text
  currency char(3) [not null, default: 'IDR']
  total_hps numeric(20,2)
  revision_reason text
  content_hash char(64) [not null]
  created_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tender_request_id, revision_number) [unique]
  }

  Note: 'Immutable after creation transaction completes.'
}

Table tender_tender_request_item {
  id uuid [pk]
  tender_revision_id uuid [not null, ref: > tender_tender_request_revision.id, note: 'CASCADE inside aggregate']
  line_number integer [not null]
  product_id uuid [not null, ref: > catalog_product.id, note: 'PROTECT']
  product_snapshot jsonb [not null]
  requested_quantity numeric(18,3) [not null]
  unit varchar(32) [not null]
  specification text
  description text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tender_revision_id, line_number) [unique]
  }
}

Table optimization_optimization_run {
  id uuid [pk]
  tender_request_id uuid [not null, ref: > tender_tender_request.id, note: 'PROTECT']
  tender_revision_id uuid [not null, ref: > tender_tender_request_revision.id, note: 'PROTECT']
  retry_of_run_id uuid [ref: > optimization_optimization_run.id, note: 'PROTECT; nullable']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING | RUNNING | COMPLETED | FAILED']
  algorithm_version varchar(32) [not null]
  snapshot_schema_version integer [not null]
  input_snapshot jsonb [not null]
  input_hash char(64) [not null]
  result_count integer [not null, default: 0]
  safe_error_code varchar(64)
  safe_error_message text
  diagnostic_reference varchar(100)
  requested_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  started_at timestamptz
  completed_at timestamptz
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tender_request_id, created_at)
    (status, created_at)
  }

  Note: 'Django migration adds partial unique constraint: one PENDING/RUNNING row per tender_request_id.'
}

Table optimization_candidate_rejection {
  id uuid [pk]
  optimization_run_id uuid [not null, ref: > optimization_optimization_run.id, note: 'CASCADE inside aggregate']
  candidate_identifier varchar(128) [not null]
  reason_code varchar(64) [not null]
  safe_detail jsonb [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (optimization_run_id, candidate_identifier) [unique]
  }
}

Table sourcing_procurement_result {
  id uuid [pk]
  tender_revision_id uuid [not null, ref: > tender_tender_request_revision.id, note: 'PROTECT']
  source_type varchar(20) [not null, note: 'MANUAL | OPTIMIZER | CUSTOMIZED']
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT | VALID']
  optimization_run_id uuid [ref: > optimization_optimization_run.id, note: 'PROTECT; required for OPTIMIZER']
  source_result_id uuid [ref: > sourcing_procurement_result.id, note: 'PROTECT; required for CUSTOMIZED']
  rank integer
  total_purchase numeric(20,2)
  currency char(3) [not null, default: 'IDR']
  calculation_version varchar(32) [not null]
  snapshot_schema_version integer
  result_snapshot jsonb
  result_hash char(64)
  validated_at timestamptz
  created_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tender_revision_id, status, total_purchase)
    (optimization_run_id, rank) [unique]
  }

  Note: 'VALID is immutable. No LOCKED status.'
}

Table sourcing_procurement_result_item {
  id uuid [pk]
  procurement_result_id uuid [not null, ref: > sourcing_procurement_result.id, note: 'CASCADE inside aggregate']
  tender_request_item_id uuid [not null, ref: > tender_tender_request_item.id, note: 'PROTECT']
  line_number integer [not null]
  requested_quantity_snapshot numeric(18,3) [not null]
  unit_snapshot varchar(32) [not null]
  item_purchase_total numeric(20,2)
  currency char(3) [not null, default: 'IDR']
  product_snapshot jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (procurement_result_id, tender_request_item_id) [unique]
    (procurement_result_id, line_number) [unique]
  }
}

Table sourcing_supplier_allocation {
  id uuid [pk]
  procurement_result_item_id uuid [not null, ref: > sourcing_procurement_result_item.id, note: 'CASCADE inside aggregate']
  supplier_offer_id uuid [not null, ref: > sourcing_supplier_offer.id, note: 'PROTECT']
  line_number integer [not null]
  allocated_quantity numeric(18,3) [not null]
  base_unit_price_snapshot numeric(20,4) [not null]
  discount_percent_snapshot numeric(7,4) [not null]
  net_purchase_price_snapshot numeric(20,4) [not null]
  allocation_purchase numeric(20,2) [not null]
  currency char(3) [not null, default: 'IDR']
  supplier_snapshot jsonb [not null]
  offer_snapshot jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (procurement_result_item_id, line_number) [unique]
    (procurement_result_item_id, supplier_offer_id) [unique]
    supplier_offer_id
  }
}

Table sourcing_procurement_result_selection {
  id uuid [pk]
  tender_request_id uuid [not null, ref: > tender_tender_request.id, note: 'PROTECT']
  tender_revision_id uuid [not null, ref: > tender_tender_request_revision.id, note: 'PROTECT']
  procurement_result_id uuid [not null, ref: > sourcing_procurement_result.id, note: 'PROTECT']
  selection_number integer [not null]
  selected_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  selected_at timestamptz [not null, default: `now()`]

  indexes {
    (tender_request_id, selection_number) [unique]
  }

  Note: 'Append-only. Greatest selection_number is current selection.'
}

Table bids_bid_proposal {
  id uuid [pk]
  proposal_number varchar(50) [not null, unique]
  tender_request_id uuid [not null, ref: > tender_tender_request.id, note: 'PROTECT']
  current_revision_number integer [not null, default: 1]
  version integer [not null, default: 1]
  created_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tender_request_id, created_at)
  }
}

Table bids_bid_proposal_revision {
  id uuid [pk]
  bid_proposal_id uuid [not null, ref: > bids_bid_proposal.id, note: 'CASCADE inside aggregate']
  revision_number integer [not null]
  tender_revision_id uuid [not null, ref: > tender_tender_request_revision.id, note: 'PROTECT']
  selected_result_id uuid [not null, ref: > sourcing_procurement_result.id, note: 'PROTECT']
  status varchar(24) [not null, default: 'DRAFT', note: 'DRAFT | WAITING_APPROVAL | APPROVED | REJECTED | SIGNED | FINALIZED']
  target_margin_percent numeric(7,4)
  total_purchase numeric(20,2)
  total_bid_value numeric(20,2)
  gross_profit numeric(20,2)
  actual_margin_percent numeric(7,4)
  max_margin_percent numeric(7,4)
  is_hps_feasible boolean
  currency char(3) [not null, default: 'IDR']
  calculation_version varchar(32) [not null]
  snapshot_schema_version integer [not null]
  selected_result_snapshot jsonb [not null]
  submission_snapshot jsonb
  submission_hash char(64)
  submitted_by_id uuid [ref: > accounts_user.id, note: 'PROTECT; nullable before submission']
  submitted_at timestamptz
  created_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (bid_proposal_id, revision_number) [unique]
    (status, updated_at)
  }
}

Table bids_bid_proposal_item {
  id uuid [pk]
  bid_revision_id uuid [not null, ref: > bids_bid_proposal_revision.id, note: 'CASCADE inside aggregate']
  tender_request_item_id uuid [not null, ref: > tender_tender_request_item.id, note: 'PROTECT']
  line_number integer [not null]
  product_snapshot jsonb [not null]
  requested_quantity numeric(18,3) [not null]
  unit varchar(32) [not null]
  item_purchase_total numeric(20,2) [not null]
  unit_purchase_cost numeric(20,4) [not null]
  bid_unit_price numeric(20,4) [not null]
  item_bid_total numeric(20,2) [not null]
  currency char(3) [not null, default: 'IDR']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (bid_revision_id, tender_request_item_id) [unique]
    (bid_revision_id, line_number) [unique]
  }
}

Table approval_approval_decision {
  id uuid [pk]
  bid_revision_id uuid [not null, unique, ref: > bids_bid_proposal_revision.id, note: 'PROTECT']
  decision varchar(16) [not null, note: 'APPROVED | REJECTED']
  reason text
  submission_hash char(64) [not null]
  decided_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT; MANAGER']
  decided_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (decided_by_id, decided_at)
  }
}

Table signatures_signature {
  id uuid [pk]
  bid_revision_id uuid [not null, unique, ref: > bids_bid_proposal_revision.id, note: 'PROTECT']
  approval_decision_id uuid [not null, unique, ref: > approval_approval_decision.id, note: 'PROTECT']
  signed_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT; same user as approver']
  signer_name varchar(255) [not null]
  signed_snapshot_hash char(64) [not null]
  image_object_key varchar(512) [unique]
  image_version_id varchar(255)
  image_mime_type varchar(100)
  image_size_bytes bigint
  image_sha256 char(64)
  signed_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
}

Table documents_generation_job {
  id uuid [pk]
  bid_revision_id uuid [not null, ref: > bids_bid_proposal_revision.id, note: 'PROTECT']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING | RUNNING | COMPLETED | FAILED']
  document_version integer [not null]
  template_version varchar(32) [not null, default: '1']
  snapshot_schema_version integer [not null]
  input_snapshot jsonb [not null]
  input_hash char(64) [not null]
  attempt_count integer [not null, default: 0]
  safe_error_code varchar(64)
  safe_error_message text
  diagnostic_reference varchar(100)
  requested_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT; PROCUREMENT_STAFF']
  started_at timestamptz
  completed_at timestamptz
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (bid_revision_id, document_version) [unique]
    (status, created_at)
  }
}

Table documents_final_document {
  id uuid [pk]
  generation_job_id uuid [not null, unique, ref: > documents_generation_job.id, note: 'PROTECT']
  bid_revision_id uuid [not null, ref: > bids_bid_proposal_revision.id, note: 'PROTECT']
  document_version integer [not null]
  document_number varchar(100) [not null]
  template_version varchar(32) [not null]
  object_key varchar(512) [not null, unique]
  object_version_id varchar(255)
  mime_type varchar(100) [not null, default: 'application/pdf']
  size_bytes bigint [not null]
  sha256 char(64) [not null]
  snapshot_schema_version integer [not null]
  content_snapshot jsonb [not null]
  finalized_by_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT; PROCUREMENT_STAFF']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (bid_revision_id, document_version) [unique]
  }
}

Table notifications_notification {
  id uuid [pk]
  recipient_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  type varchar(40) [not null, note: 'OPTIMIZATION_COMPLETED | OPTIMIZATION_FAILED | BID_REJECTED']
  source_event_id uuid [not null]
  source_entity_type varchar(64) [not null]
  source_entity_id uuid [not null]
  title varchar(255) [not null]
  message text [not null]
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (recipient_id, source_event_id, type) [unique]
    (recipient_id, read_at, created_at)
  }
}

Table audit_audit_event {
  id uuid [pk]
  actor_id uuid [ref: > accounts_user.id, note: 'PROTECT; null for system actor']
  actor_name varchar(255) [not null]
  entity_type varchar(64) [not null]
  entity_id uuid [not null]
  entity_revision integer
  action varchar(64) [not null]
  from_status varchar(32)
  to_status varchar(32)
  reason text
  metadata jsonb [not null]
  correlation_id varchar(100) [not null]
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, occurred_at)
    (actor_id, occurred_at)
  }

  Note: 'Append-only. Logical entity reference intentionally has no polymorphic FK.'
}

Table core_idempotency_record {
  id uuid [pk]
  actor_id uuid [not null, ref: > accounts_user.id, note: 'PROTECT']
  operation varchar(64) [not null]
  idempotency_key varchar(128) [not null]
  request_hash char(64) [not null]
  status varchar(20) [not null, default: 'IN_PROGRESS', note: 'IN_PROGRESS | COMPLETED | FAILED']
  result_entity_type varchar(64)
  result_entity_id uuid
  safe_response jsonb
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (actor_id, operation, idempotency_key) [unique]
    expires_at
  }

  Note: 'Logical result reference intentionally has no polymorphic FK.'
}
