APP_ENV=demo
DJANGO_SETTINGS_MODULE=config.settings.demo
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=procurement.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://procurement.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600

POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=replace-with-a-strong-random-postgres-password
DATABASE_URL=postgresql://procurement:replace-with-a-strong-random-postgres-password@postgres:5432/procurement

CELERY_BROKER_URL=redis://redis:6379/0
DJANGO_CACHE_URL=redis://redis:6379/1

MINIO_ROOT_USER=replace-with-a-random-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-strong-random-minio-secret-key
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-a-random-minio-access-key
MINIO_SECRET_KEY=replace-with-a-strong-random-minio-secret-key
MINIO_BUCKET=procurement-private
MINIO_SECURE=false

APP_BASE_URL=https://procurement.example.com
DEMO_ADMIN_PASSWORD=replace-with-a-strong-random-admin-password
DEMO_STAFF_PASSWORD=replace-with-a-strong-random-staff-password
DEMO_MANAGER_PASSWORD=replace-with-a-strong-random-manager-password

WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=8002
