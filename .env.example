# Use with: uv run --env-file .env python manage.py <command>
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local Unix-socket connection. Use a full URL when authentication is required.
DATABASE_URL=postgresql:///procurement
TEST_DATABASE_URL=postgresql:///procurement_test

CELERY_BROKER_URL=redis://127.0.0.1:6379/0

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-local-access-key
MINIO_SECRET_KEY=replace-with-local-secret-key
MINIO_BUCKET=procurement-private
MINIO_SECURE=false

APP_BASE_URL=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
